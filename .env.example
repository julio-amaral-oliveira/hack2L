# Copie para .env.local e preencha. .env.local nunca é commitado.

# --- LLM: basta UMA das duas. Sem nenhuma, ingest/entrevista/copy caem em mock.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# anthropic | openai — sem isso, resolve na ordem: anthropic, depois openai.
LLM_PROVIDER=

# --- Análise de mercado. Sem a chave, a caixa cai no fixture real de
# demo/ifood/evidence (search_id 4554b5ce…ab84), e a demo continua de pé.
GORILLA_API_KEY=

# --- Vídeo: google (Veo) | mock (MP4 em cache) | openai (Sora — DESCONTINUADO).
# ATENÇÃO: o Sora 2 foi descontinuado em 26/04/2026 e a API desliga em
# 24/09/2026. Não use 'openai' numa apresentação.
VIDEO_PROVIDER=mock
GOOGLE_GENERATIVE_AI_API_KEY=
# MP4 servido pelo provider mock, relativo a public/.
VIDEO_CACHE_PATH=/videos/ifood-cache.mp4

# --- Interruptores de palco: forçam o caminho determinístico mesmo com chave
# válida. Ligue se a rede do evento estiver ruim ou o LLM instável.
MOCK_LLM=0
INTERVIEW_MOCK=0
MOCK_RESEARCH=0

LANDING_PAGE_URL=https://brandloop-lp.vercel.app
